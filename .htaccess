<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /webJmcImport/

    # Leave real files alone. Everything else goes to the Laravel front controller.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.php [L]
</IfModule>
